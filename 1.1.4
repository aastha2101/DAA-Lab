#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define INF 9999
int findRepresentative(int i, int parent[]) {
    while (parent[i] != i)
        i = parent[i];
    return i;
}

// Function to perform the union of two sets
void unionSets(int i, int j, int parent[]) {
    int root_i = findRepresentative(i, parent);
    int root_j = findRepresentative(j, parent);
    parent[root_i] = root_j;
}

void kruskalMST(int **cost, int V) {
int *parent = (int *)malloc(V * sizeof(int));
    
    // Initialize each vertex as its own parent/set
    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    int edge_count = 0;
    int min_cost = 0;

    // An MST of V vertices always contains exactly V - 1 edges
    while (edge_count < V - 1) {
        int min = INF;
        int u = -1, v = -1;

        // Find the minimum weight edge that doesn't cause a cycle
        for (int i = 0; i < V; i++) {
            for (int j = 0; j < V; j++) {
                // If it's a valid edge and smaller than our current minimum
                if (cost[i][j] < min && findRepresentative(i, parent) != findRepresentative(j, parent)) {
                    min = cost[i][j];
                    u = i;
                    v = j;
                }
            }
        }

        // If no valid edge is found, the graph is not fully connected
        if (u == -1 || v == -1) {
            break;
        }

        // Include the edge in the MST
        unionSets(u, v, parent);
        printf("Edge %d:(%d, %d) cost:%d\n", edge_count, u, v, min);
        min_cost += min;
        edge_count++;
    }

    printf("Minimum cost= %d\n", min_cost);
    
    free(parent);
}

int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
