#include <stdio.h>
#include <stdlib.h>

// Utility function to find the maximum of two integers
int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) {
        return 0;
    }

    int *values = (int *)malloc(n * sizeof(int));
    int *weights = (int *)malloc(n * sizeof(int));

    for (int i = 0; i < n; i++) {
        if (scanf("%d", &values[i]) != 1) {
            return 0;
        }
    }

    for (int i = 0; i < n; i++) {
        if (scanf("%d", &weights[i]) != 1) {
            return 0;
        }
    }

    int w;
    if (scanf("%d", &w) != 1) {
        return 0;
    }

    // Allocate memory for DP array and initialize with 0
    int *dp = (int *)calloc(w + 1, sizeof(int));

    // Build the DP table in a bottom-up manner
    for (int i = 0; i < n; i++) {
        // Traverse backwards to prevent using the same item multiple times
        for (int j = w; j >= weights[i]; j--) {
            dp[j] = max(dp[j], dp[j - weights[i]] + values[i]);
        }
    }

    // The maximum value that can be achieved with capacity W
    printf("%d\n", dp[w]);

    // Free allocated memory
    free(values);
    free(weights);
    free(dp);

    return 0;
}
