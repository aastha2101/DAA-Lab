#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

void dijkstra(int G[MAX][MAX], int n, int startnode) {
	
	int distance[MAX];
    int visited[MAX];
    int parent[MAX];
    int i, j, count;
    int min, next;

    // Initialize
    for (i = 1; i <= n; i++) {
        distance[i] = INFINITY;
        visited[i] = 0;
        parent[i] = -1;
    }

    distance[startnode] = 0;

    // Dijkstra's algorithm
    for (count = 1; count <= n; count++) {
        min = INFINITY;
        next = -1;

        // Find the unvisited vertex with minimum distance
        for (i = 1; i <= n; i++) {
            if (!visited[i] && distance[i] < min) {
                min = distance[i];
                next = i;
            }
        }

        // No more reachable vertices
        if (next == -1)
            break;

        visited[next] = 1;

        // Update distances of adjacent vertices
        for (i = 1; i <= n; i++) {
            if (!visited[i] && G[next][i] != 0 &&
                distance[next] + G[next][i] < distance[i]) {

                distance[i] = distance[next] + G[next][i];
                parent[i] = next;
            }
        }
    }

    // Print output
    printf("Node\tDistance\tPath\n");

    for (i = 1; i <= n; i++) {
        if (i == startnode)
            continue;

        printf(" %3d\t", i);

        if (distance[i] == INFINITY) {
            printf("INF\t\tNO PATH\n");
        } else {
            printf("%7d\t", distance[i]);

            // Print path backwards
            printf("%d", i);

            j = i;
            while (parent[j] != -1) {
                printf("<-%d", parent[j]);
                j = parent[j];
            }

            printf("\n");
        }
	}
	
}
int main() { 
	int s, d, w, i, j;
	printf("Enter the number of vertices : ");
	scanf("%d", &V);
	printf("Enter the number of edges : ");
	scanf("%d", &E);
	for(i = 1 ; i <= V; i++) {
		for(j = 1; j <= V; j++) {
			graph[i][i] = 0;
		}
	}
	for(i = 1; i <= E; i++) {
		printf("Enter source : ");
		scanf("%d", &s);
		printf("Enter destination : ");
		scanf("%d", &d);
		printf("Enter weight : ");
		scanf("%d", &w);
		if(s > V || d > V || s <= 0 || d <= 0) {
			printf("Invalid index. Try again.\n");
			i--;
			continue;
		} else {
			graph[s][d] = w;
		}
	}
	printf("Enter the source :");
	scanf("%d", &s);
	dijkstra(graph, V, s); 
	return 0; 
} 
